# Server configuration
PORT=3000
NODE_ENV=development

# Authentication (Bearer token for accessing this API)
API_BEARER_TOKEN=my-secret-backend-token-12345

# CoinMarketCap API Configuration
# Get your free key at https://pro.coinmarketcap.com/
CMC_API_KEY=your_coinmarketcap_api_key_here
CMC_BASE_URL=https://pro-api.coinmarketcap.com
CMC_TIMEOUT_MS=10000

# Database Configuration (SQLite file path)
DB_PATH=./data/crypto_tracker.db

# Currency (Single currency across the application)
BASE_CURRENCY=USD

# Background Synchronization
SYNC_ENABLED=true
SYNC_INTERVAL_MS=120000
